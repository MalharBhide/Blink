# Copy to .env. The application works with deterministic answers without a key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# The encryption key is generated in .data/key when omitted. Back it up securely.
ENCRYPTION_KEY=
DATABASE_URL=sqlite:///.data/app.sqlite3
DATA_DIR=.data
BROWSER_HEADLESS=false
ENABLE_MOCK_PORTAL=true
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
